<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Feverfew</RootNamespace>
    <AssemblyName>Feverfew</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>TessArdent</Authors>
    <Company>TessArdent</Company>
    <Product>Feverfew</Product>
    <Description>Collects hardware and software diagnostics into a single shareable report.</Description>
    <Copyright>Copyright (c) 2026 TessArdent</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\feverfew.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Resource Include="..\..\assets\feverfew.ico" Link="feverfew.ico" />
  </ItemGroup>

</Project>
